# ---- Core ----
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/laadlibytes

# ---- Auth ----
# Min 32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_64_char_random_hex_string_min_32
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---- OTP ----
# Min 32 chars. HMAC key for stored OTP hashes; generate the same way as the JWT secrets.
OTP_SECRET=1bf3ec1b76b50d501030565a2d381aa2d13b96f67a6bd16352a3657774e57b48
# ---- Email (OTP delivery) ----
# console = print emails to the server log (not allowed in production) | smtp
EMAIL_PROVIDER=console
# Required when EMAIL_PROVIDER=smtp, e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
EMAIL_FROM=

# ---- SMS (OTP delivery) ----
# console = print codes to the server log (not allowed in production) | msg91
SMS_PROVIDER=console
# Required when SMS_PROVIDER=msg91 (template must be DLT-approved)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ---- CORS ----
# Comma-separated origins, or * to allow any
CORS_ORIGIN=http://localhost:5173

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- Logging ----
LOG_LEVEL=info

# ---- External services (add as they are integrated) ----
# CLOUDINARY_URL=
