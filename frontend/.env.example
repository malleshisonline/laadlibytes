# Full API base URL used by production builds, e.g. https://<api-host>/api.
# Leave unset in development: requests go to /api through the Vite proxy.
VITE_API_BASE_URL=

# Development only: where the Vite proxy sends /api, e.g. the deployed API origin,
# or http://localhost:5000 for a local backend.
VITE_DEV_PROXY_TARGET=